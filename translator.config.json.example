{
  "app_version": "3.1.0-direct-gguf-metal",
  "paths": {
    "model_root": "/Users/farhi/Documents/Programming/Ai-Models",
    "data_dir": "./translator_data"
  },
  "models": {
    "madlad_7b_bt_gpu": {
      "backend": "ctranslate2",
      "path": "${MODEL_ROOT}/madlad",
      "tokenizer_path": "${MODEL_ROOT}/madlad",
      "device": "auto",
      "cuda_compute_type": "int8_float16",
      "cpu_compute_type": "int8",
      "allow_cpu_fallback": true,
      "max_source_tokens": 420,
      "max_decoding_length": 640,
      "beam_size": 2,
      "max_batch_size": 1536,
      "repetition_penalty": 1.05,
      "no_repeat_ngram_size": 0,
      "target_tags": {
        "fa": "fa",
        "en": "en",
        "ar": "ar"
      }
    },
    "madlad_7b_bt_cpu": {
      "backend": "ctranslate2",
      "path": "${MODEL_ROOT}/madlad",
      "tokenizer_path": "${MODEL_ROOT}/madlad",
      "device": "cpu",
      "compute_type": "int8",
      "cpu_compute_type": "int8",
      "allow_cpu_fallback": false,
      "max_source_tokens": 420,
      "max_decoding_length": 640,
      "beam_size": 1,
      "max_batch_size": 768,
      "repetition_penalty": 1.05,
      "no_repeat_ngram_size": 0,
      "target_tags": {
        "fa": "fa",
        "en": "en",
        "ar": "ar"
      }
    },
    "gemma3_12b": {
      "backend": "llama_cpp",
      "path": "${MODEL_ROOT}/gemma/google_gemma-3-12b-it-Q4_K_M.gguf",
      "context_size": 8192,
      "batch_size": 256,
      "gpu_layers": "auto",
      "threads": "auto",
      "use_mmap": true,
      "use_mlock": false,
      "top_p": 0.9,
      "repeat_penalty": 1.03,
      "verbose": false
    },
    "dorna_8b_q5": {
      "backend": "llama_cpp",
      "path": "${MODEL_ROOT}/dorna/dorna-llama3-8b-instruct.Q5_K_M.gguf",
      "context_size": 8192,
      "batch_size": 256,
      "gpu_layers": "auto",
      "threads": "auto",
      "use_mmap": true,
      "use_mlock": false,
      "top_p": 0.9,
      "repeat_penalty": 1.03,
      "verbose": false,
      "chat_format": "llama-3"
    }
  },
  "profiles": {
    "high": {
      "translator": "madlad_7b_bt_gpu",
      "analyst": "gemma3_12b",
      "reviewer": "gemma3_12b",
      "polisher": "dorna_8b_q5",
      "max_units_per_request": 5,
      "polisher_max_units": 4
    },
    "low": {
      "translator": "madlad_7b_bt_cpu",
      "analyst": "gemma3_12b",
      "reviewer": "gemma3_12b",
      "polisher": "dorna_8b_q5",
      "max_units_per_request": 3,
      "polisher_max_units": 2
    }
  },
  "runtime": {
    "memory_profile": "auto",
    "low_memory_threshold_gb": 12,
    "max_parallel_jobs": 1,
    "max_queued_jobs": 3,
    "host": "127.0.0.1",
    "port": 5000,
    "max_upload_mb": 100
  },
  "translation": {
    "quality_mode": "balanced",
    "editor_temperature": 0.05,
    "polisher_temperature": 0.08,
    "max_retries": 2,
    "reserved_output_tokens": 1400,
    "analysis_max_chars": 12000,
    "mt_units_per_batch": 8,
    "mt_batch_items": 8,
    "mt_long_piece_batch": 4,
    "quality_repair_attempts": 1,
    "default_tone": "auto",
    "locked_glossary": []
  },
  "documents": {
    "libreoffice_path": "auto",
    "fallback_fonts": {
      "fa": "Vazirmatn",
      "ar": "Noto Naskh Arabic",
      "en": "Arial"
    },
    "font_files": {
      "fa": "./font/Vazirmatn-VariableFont_wght.ttf",
      "ar": "./font/Vazirmatn-VariableFont_wght.ttf"
    },
    "pdf_min_scale": 0.62
  },
  "storage": {
    "retention_days": 7
  }
}
