{
  "app_version": "2.1.0-job-control",
  "paths": {
    "model_root": "PUT_YOU_ADDRESS_HERE",
    "data_dir": "./translator_data"
  },
  "models": {
    "qwen_14b": {
      "path": "${MODEL_ROOT}/qwen2.5-14b-gguf/Qwen2.5-14B-Instruct-Q4_K_M.gguf",
      "chat_format": null
    },
    "gemma_12b": {
      "path": "${MODEL_ROOT}/gemma-3-12b-it-gguf/google_gemma-3-12b-it-Q4_K_M.gguf",
      "chat_format": null
    },
    "gemma_4b": {
      "path": "${MODEL_ROOT}/gemma-3-4b-it-gguf/google_gemma-3-4b-it-Q4_K_M.gguf",
      "chat_format": null
    }
  },
  "profiles": {
    "high": {
      "translator": "qwen_14b",
      "reviewer": "gemma_12b",
      "context_size": 6144,
      "batch_size": 256,
      "max_units_per_request": 8
    },
    "low": {
      "translator": "gemma_4b",
      "reviewer": "gemma_4b",
      "context_size": 4096,
      "batch_size": 128,
      "max_units_per_request": 5
    }
  },
  "runtime": {
    "memory_profile": "auto",
    "low_memory_threshold_gb": 10,
    "gpu_layers": "auto",
    "threads": "auto",
    "max_parallel_jobs": 1,
    "max_queued_jobs": 3,
    "host": "127.0.0.1",
    "port": 5000,
    "max_upload_mb": 100
  },
  "translation": {
    "temperature": 0.15,
    "editor_temperature": 0.1,
    "max_retries": 2,
    "reserved_output_tokens": 1536,
    "context_safety_tokens": 512,
    "previous_units": 3,
    "summary_refresh_batches": 6,
    "quality_repair_attempts": 2,
    "default_tone": "auto"
  },
  "documents": {
    "libreoffice_path": "auto",
    "fallback_fonts": {
      "fa": "Vazirmatn",
      "ar": "Noto Naskh Arabic",
      "en": "Arial"
    },
    "font_files": {
      "fa": "./font/Vazirmatn-VariableFont_wght.ttf",
      "ar": "./font/Vazirmatn-VariableFont_wght.ttf"
    },
    "pdf_min_scale": 0.62
  },
  "storage": {
    "retention_days": 7
  }
}
